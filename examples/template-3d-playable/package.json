{
  "name": "omnicore-template-3d-playable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playable OmniCore 3D starter with third-person camera, Rapier collision, pickup, animation switching, and export metadata.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43330",
    "start": "npm run dev",
    "export:web": "omni export --target web --scene scene.omnicore.json",
    "export:electron": "omni export --target electron --scene scene.omnicore.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "omnicore": "file:../..",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "vite": "^8.1.0"
  }
}
