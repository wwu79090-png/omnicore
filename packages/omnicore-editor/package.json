{
  "name": "omnicore-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "electron.main.cjs",
  "bin": {
    "omnicore-editor": "bin/omnicore-editor.cjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43210",
    "desktop": "electron .",
    "package:desktop": "node scripts/package-desktop.cjs",
    "build": "vite build"
  },
  "omnicoreEditor": {
    "standalone": true,
    "stack": {
      "view": "React",
      "graph": "React Flow",
      "canvas": [
        "Fabric.js",
        "Konva.js"
      ],
      "collaboration": "Yjs",
      "state": "Zustand"
    },
    "transports": [
      "WebSocket",
      "WebRTC"
    ],
    "exports": [
      "EventSheet",
      "BehaviorTree",
      "UI_Layout"
    ]
  },
  "build": {
    "productName": "OmniCore Editor",
    "appId": "dev.omnicore.editor",
    "desktopTargets": [
      "omnicore-editor.exe",
      "OmniCore Editor.app",
      "OmniCore Editor.dmg",
      "OmniCore Editor.AppImage"
    ],
    "files": [
      "dist",
      "electron.main.cjs",
      "workspace.cjs",
      "preload.cjs",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "vite": "^8.0.16"
  }
}
