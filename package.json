{
  "name": "omnicore",
  "version": "0.1.0",
  "description": "OmniCore 2D-first Web game engine core with native WebGPU rendering, event sheets, component prefabs, and industrial asset pipelines.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./lean": "./src/lean/index.js",
    "./core": "./src/lean/index.js"
  },
  "bin": {
    "omni": "./scripts/omni.js",
    "omni-migrate": "./scripts/omni-migrate.js",
    "create-omnicore-app": "./scripts/create-omnicore-app.mjs",
    "create-omnicore-plugin-sdk": "./create-omnicore-plugin-sdk/index.mjs",
    "omnicore-editor": "packages/omnicore-editor/bin/omnicore-editor.cjs"
  },
  "files": [
    "src",
    "examples",
    "scripts",
    "create-omnicore-plugin-sdk",
    "migration",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "GOVERNANCE.md",
    "LTS.md",
    "CREDITS.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "editor": "node packages/omnicore-editor/bin/omnicore-editor.cjs",
    "prebuild": "npm run dependency:forensics && npm run audit:deprecated && node scripts/build-static-batches.js --optional && node scripts/optimize-source.js && node scripts/bake-tilemap-collisions.js --optional",
    "build": "vite build",
    "postbuild": "node scripts/verify-build-output.js",
    "build:prod": "vite build --mode production",
    "build:wechat": "node scripts/build-wechat.js",
    "build:mobile": "node scripts/generate-mobile-shells.js",
    "build:addon": "node scripts/build-addon.js",
    "pipeline": "node scripts/pipeline.js --assets assets --out dist/assets",
    "bundle:assets": "node scripts/build-obundle.js --assets assets --out dist/assets.omnicore.obundle",
    "audit:assets": "node scripts/audit-assets.js",
    "import": "node scripts/asset-importer.js --source source-assets --out assets --platforms web,wechat,electron",
    "watch:assets": "node scripts/asset-watch-server.js --source source-assets",
    "ota:patch": "node scripts/ota-patch.js",
    "import:assets": "node scripts/import-assets.js",
    "import:source-assets": "node scripts/asset-importer.js --source source-assets --out dist/imported-assets",
    "pack:assets": "node scripts/pack-assets.js --assets assets --scenes examples --out dist/assets",
    "build:platform-assets": "node scripts/build-platform-assets.js",
    "make": "node scripts/make.js",
    "generate-icons": "node scripts/generate-icons.js",
    "publish:local": "node scripts/publish-local.js",
    "deploy": "node scripts/deploy.js",
    "export:platform": "node scripts/export-platform.js",
    "dist:full": "node scripts/dist-full.js",
    "log-server": "node scripts/log-server.js",
    "snapshot": "node scripts/snapshot.js",
    "launch:dev": "node scripts/launch-dev.js",
    "docs": "node scripts/docs.js",
    "docs:generate": "node scripts/generate-api-docs.js --out docs/api",
    "docs:build": "npm run docs:generate && npm run docs:api",
    "docs:api": "node scripts/generate-api-docs.js",
    "docs:typedoc": "typedoc --options typedoc.json",
    "audit:api": "node scripts/audit-api-style.js",
    "audit:asset-conventions": "node scripts/audit-asset-conventions.js",
    "production-ready": "node scripts/production-ready.js",
    "quality:gate": "node scripts/production-ready.js --verify",
    "quality:engine": "node scripts/engine-quality-gate.js",
    "doctor": "node scripts/engine-doctor.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:mobile": "node scripts/benchmark.js complex-scene-benchmark",
    "benchmark:heavy": "node scripts/benchmark-heavy.js",
    "benchmark:device-baseline": "node scripts/update-device-baseline.js",
    "benchmark:hardware-baseline": "node scripts/update-hardware-baseline.js",
    "benchmark:ci": "node scripts/benchmark-threshold.js",
    "performance:budget": "node scripts/performance-budget.js",
    "screenshots:compare": "node scripts/compare-screenshots.js --baseline tests/e2e/__screenshots__/editor-baseline.png --current \"tests/e2e/__screenshots__/editor-current-*.png\" --threshold 0.05",
    "test": "vitest run",
    "test:contract": "node scripts/contract-test.js",
    "browsers:install": "playwright install chromium firefox webkit",
    "pretest:e2e": "playwright install chromium firefox webkit",
    "test:e2e": "playwright test tests/e2e",
    "test:wechat": "node scripts/test-wechat.js",
    "test:minigame": "node scripts/test-minigame.js",
    "test:visual": "node scripts/visual-regression.js --threshold 0.005",
    "lint": "eslint -c .eslintrc.json --no-eslintrc src tests scripts --ext .js,.mjs",
    "lint:fix": "eslint -c .eslintrc.json --no-eslintrc src tests scripts --ext .js,.mjs --fix",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "changelog": "node scripts/update-changelog.js",
    "prepare": "npm run docs:generate && husky",
    "health": "node scripts/health-check.js",
    "audit:deprecated": "node scripts/audit-deprecated.js",
    "governance:triage": "node scripts/governance-triage.js",
    "marketplace:generate": "node scripts/generate-marketplace-site.js",
    "marketplace:validate": "node scripts/validate-marketplace-index.js",
    "security-check": "node scripts/security-check.js",
    "dependency:forensics": "node scripts/dependency-forensics.js",
    "test:mem": "node scripts/health-check.js --memory",
    "test:backends": "node scripts/health-check.js --backends"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi": "^4.1.56",
    "nanostores": "^1.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@omnicore/core-wasm": "file:packages/omnicore-core-wasm",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "npm-check-updates": "^18.3.1",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "typedoc": "^0.28.19",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "game-engine",
    "pixijs",
    "html5",
    "webgl",
    "canvas",
    "wechat-minigame",
    "electron"
  ],
  "license": "MIT"
}
