{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniCore Developer Knowledge Pattern",
  "type": "object",
  "required": ["id", "title", "pattern", "trigger", "intent", "solution", "example", "docs"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "pattern": { "type": "string" },
    "flags": { "type": "string", "default": "i" },
    "trigger": { "type": "string" },
    "intent": { "type": "string" },
    "solution": { "type": "string" },
    "example": { "type": "string" },
    "docs": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warn", "error"], "default": "warn" },
    "source": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "issue": { "type": "string" },
        "repo": { "type": "string" }
      }
    }
  }
}
